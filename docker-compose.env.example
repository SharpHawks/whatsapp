# Production environment variables for docker-compose
# Copy to .env and fill with real values before: docker-compose up -d

# Required for production
DB_PASSWORD=your_strong_postgres_password
RABBITMQ_USER=whatsapp
RABBITMQ_PASSWORD=your_rabbitmq_password
JWT_SECRET=generate_with_node_e_console_log_require_crypto_randomBytes_64_toString_hex
JWT_REFRESH_SECRET=generate_different_64_char_hex_string
API_KEY_ENCRYPTION_SECRET=generate_different_stable_64_char_hex_string

# Optional - for Redis auth
REDIS_PASSWORD=

# CORS - exact browser origins (scheme + host + port if not 80/443)
# e.g. http://YOUR_VPS_IP  or  http://YOUR_VPS_IP:8080
CORS_ORIGINS=http://YOUR_VPS_IP

# After first deploy, create DB tables (run on host against running stack):
# docker compose exec api-server node scripts/run-migrations.cjs
