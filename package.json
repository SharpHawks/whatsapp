{
  "name": "whatsapp-api-monetization",
  "version": "1.0.0",
  "description": "WhatsApp API Monetization Platform with Baileys integration",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node scripts/start-dev-stable.js",
    "dev:simple": "node scripts/start-dev-simple.js",
    "dev:api": "cross-env WORKER_ENABLED=false nodemon",
    "dev:worker": "cross-env WORKER_ENABLED=true ts-node-dev --respawn --watch src/workers --watch src/services/worker-baileys.manager.ts src/workers/message.worker.ts",
    "dev:full": "node scripts/start-dev.js",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:api": "cross-env WORKER_ENABLED=false node dist/index.js",
    "start:worker": "cross-env WORKER_ENABLED=true node dist/workers/message.worker.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "worker": "ts-node src/workers/message.worker.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate": "ts-node scripts/migrate.ts",
    "migrate:prod": "node scripts/run-migrations.cjs",
    "db:init": "bash scripts/init-db.sh",
    "check:env": "node scripts/check-env.js",
    "setup:db": "node scripts/setup-db.js",
    "setup": "npm run check:env && npm run setup:db",
    "cleanup:bots": "node scripts/cleanup-bot-sessions.js",
    "reset:bots": "node scripts/reset-all-bots.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:send": "node scripts/test-send-message.js",
    "add:balance": "node scripts/add-balance.js"
  },
  "keywords": [
    "whatsapp",
    "api",
    "baileys",
    "monetization"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/compression": "^1.8.1",
    "@whiskeysockets/baileys": "^6.7.9",
    "amqplib": "^0.10.3",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.3",
    "redis": "^4.6.12",
    "socket.io": "^4.8.1",
    "stripe": "^14.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.4",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.14",
    "@types/qrcode": "^1.5.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "node-pg-migrate": "^6.2.2",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
