# Production Environment Configuration
# IMPORTANT: Generate all secrets using: node scripts/generate-secrets.js

# Server Configuration
NODE_ENV=production
PORT=3000
API_VERSION=v1

# CORS Configuration (REQUIRED for production)
# Add your production domains here (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com

# HTTPS Configuration
ENABLE_HTTPS_REDIRECT=true

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=whatsapp_api
DB_USER=postgres
DB_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Configuration (REQUIRED password for production)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=GENERATE_STRONG_REDIS_PASSWORD_HERE
REDIS_DB=0

# JWT Configuration (REQUIRED - generate with scripts/generate-secrets.js)
JWT_SECRET=GENERATE_64_BYTE_HEX_STRING_HERE
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_64_BYTE_HEX_STRING_HERE
JWT_REFRESH_EXPIRES_IN=7d

# API Key Encryption (REQUIRED - keep stable across deploys)
API_KEY_ENCRYPTION_SECRET=GENERATE_DIFFERENT_64_BYTE_HEX_STRING_HERE

# RabbitMQ Configuration
RABBITMQ_URL=amqp://whatsapp:GENERATE_STRONG_RABBITMQ_PASSWORD_HERE@rabbitmq:5672
RABBITMQ_QUEUE_NAME=whatsapp_messages
RABBITMQ_CONNECT_ATTEMPTS=10
RABBITMQ_CONNECT_RETRY_DELAY_MS=2000

# Stripe Configuration (use live keys for production)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=EUR

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@yourdomain.com

# Cloud Storage (AWS S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=whatsapp-media-files-production

# Rate Limiting (adjust based on your needs)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Request Size Limit
MAX_REQUEST_SIZE=10mb

# Message Pricing (EUR)
PRICE_TEXT=0.05
PRICE_IMAGE=0.10
PRICE_VIDEO=0.20
PRICE_DOCUMENT=0.10
PRICE_AUDIO=0.10
PRICE_INTERACTIVE=0.15

# Withdrawal Configuration
MIN_WITHDRAWAL_AMOUNT=100
WITHDRAWAL_FEE_PERCENT=2

# Baileys Configuration
BAILEYS_SESSION_PATH=/app/sessions

# Worker Configuration
WORKER_ENABLED=true
WORKER_HEALTH_CHECK_INTERVAL=30000
WORKER_HEARTBEAT_INTERVAL=10000
SHUTDOWN_TIMEOUT=30000
WORKER_HEALTH_PORT=3001

# Distributed Lock Configuration
REDIS_LOCK_TTL=30000

# Logging
LOG_LEVEL=info
