# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# CORS Configuration (comma-separated list of allowed origins for production)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Database Configuration (Docker PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=whatsapp_api
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_IN_PRODUCTION
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=60000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_IN_PRODUCTION
REDIS_DB=0

# JWT Configuration
# IMPORTANT: Generate strong random secrets for production!
# You can use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_HEX_STRING_IN_PRODUCTION
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=CHANGE_THIS_TO_DIFFERENT_RANDOM_64_CHAR_HEX_STRING_IN_PRODUCTION
JWT_REFRESH_EXPIRES_IN=7d

# API Key Encryption
# Keep stable. Rotating this secret makes stored API keys unrevealable until regenerated.
API_KEY_ENCRYPTION_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_HEX_STRING_IN_PRODUCTION

# RabbitMQ Configuration
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_USER=whatsapp
RABBITMQ_PASSWORD=CHANGE_THIS_RABBITMQ_PASSWORD
RABBITMQ_CONNECT_ATTEMPTS=10
RABBITMQ_CONNECT_RETRY_DELAY_MS=2000

# Stripe Configuration (use test keys for development)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=EUR

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@yourdomain.com

# Cloud Storage (AWS S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=whatsapp-media-files

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Message Pricing (EUR)
PRICE_TEXT=0.05
PRICE_IMAGE=0.10
PRICE_VIDEO=0.20
PRICE_DOCUMENT=0.10
PRICE_AUDIO=0.10
PRICE_INTERACTIVE=0.15

# Withdrawal Configuration
MIN_WITHDRAWAL_AMOUNT=100
WITHDRAWAL_FEE_PERCENT=2

# Baileys Configuration
BAILEYS_SESSION_PATH=./sessions

# Worker Configuration
WORKER_ENABLED=true
WORKER_HEALTH_CHECK_INTERVAL=30000
SHUTDOWN_TIMEOUT=30000

# Distributed Lock Configuration
REDIS_LOCK_TTL=30000

# Grafana Loki (optional - for centralized log aggregation)
LOKI_HOST=
LOKI_BASIC_AUTH=
LOKI_APP_LABEL=whatsapp-api
LOKI_INTERVAL=5

# Socket.IO (for PM2 cluster / multi-instance)
SOCKET_PATH=/socket.io
SOCKETIO_REDIS_ADAPTER=true
SOCKETIO_CORS_ORIGINS=
